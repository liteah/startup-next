{
	"semi": false,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"tabWidth": 2,
	"useTabs": true,
	"endOfLine": "auto",
	"printWidth": 120,
	"arrowParens": "always",
	"proseWrap": "always",
	"htmlWhitespaceSensitivity": "strict",
	"jsxBracketSameLine": false,
	"bracketSpacing": true,
	"insertPragma": false,
	"requirePragma": false,
	"quoteProps": "as-needed",
	"plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
	"importOrder": [
		"^(react/(.*)$)|^(react$)",
		"^(next/(.*)$)|^(next$)",
		"<BUILTIN_MODULES>",
		"<THIRD_PARTY_MODULES>",
		"",
		"^types$",
		"^@/env(.*)$",
		"^@/types/(.*)$",
		"^@/config/(.*)$",
		"^@/lib/(.*)$",
		"^@/hooks/(.*)$",
		"^@/components/ui/(.*)$",
		"^@/components/magicui/(.*)$",
		"^@/components/(.*)$",
		"^@/styles/(.*)$",
		"^@/app/(.*)$",
		"",
		"^[./]"
	],
	"importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"]
}
