{
  "extends": [
    "next/core-web-vitals",
    "prettier"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "React": "readonly"
  },
  "plugins": ["prettier"],
  "rules": {
    "jsx-quotes": [2, "prefer-single"],
    "import/no-cycle": "off",
    "import/no-extraneous-dependencies": "off",
    "import/no-relative-parent-imports": "off",
    "import/no-anonymous-default-export": "off"
  }
}
